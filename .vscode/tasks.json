{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated",
    "clear": true
  },
  "tasks": [
    {
      "label": "ACField: Setup Python",
      "type": "process",
      "command": "uv",
      "args": ["sync", "--frozen", "--python", "3.12", "--extra", "test"],
      "problemMatcher": []
    },
    {
      "label": "ACField: Setup JavaScript",
      "type": "process",
      "command": "npm",
      "args": ["ci"],
      "problemMatcher": []
    },
    {
      "label": "ACField: Setup Console",
      "type": "process",
      "command": "npm",
      "args": ["ci"],
      "options": {"cwd": "${workspaceFolder}/robot_server/frontend"},
      "problemMatcher": []
    },
    {
      "label": "ACField: Setup Chromium",
      "type": "process",
      "command": "npx",
      "args": ["--no-install", "playwright", "install", "chromium"],
      "problemMatcher": []
    },
    {
      "label": "ACField: Setup Firmware Dependencies",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "--no-project", "--python", "3.12",
        "--with", "platformio==6.1.18",
        "python", "-m", "platformio", "pkg", "install",
        "-d", "esp32_software/firmware", "-e", "general-driver"
      ],
      "problemMatcher": []
    },
    {
      "label": "ACField: Setup Local Tests",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ACField: Setup Python",
        "ACField: Setup JavaScript",
        "ACField: Setup Console",
        "ACField: Setup Chromium",
        "ACField: Setup Firmware Dependencies"
      ],
      "problemMatcher": []
    },
    {
      "label": "CI: SDK Tests",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "--frozen", "--python", "3.12", "--extra", "test",
        "python", "-m", "pytest", "sdk/python/tests", "-q"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "CI: SDK Types",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "--frozen", "--python", "3.12", "--extra", "test",
        "python", "-m", "mypy", "sdk/python/src", "--strict"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "CI: Control and Firmware Contract",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "--project", "${workspaceFolder}", "--frozen",
        "--python", "3.12", "--extra", "test",
        "python", "-m", "pytest", "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}/robot_server",
        "env": {"ACFIELD_REQUIRE_FIRMWARE_CONTRACT": "1"}
      },
      "dependsOn": "ACField: Setup Firmware Dependencies",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "CI: Vision Tests",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "--frozen", "--python", "3.12", "--extra", "test",
        "python", "-m", "pytest", "-q", "tests/test_apriltag_live.py",
        "tests/test_vision_configuration.py"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "CI: Generate Labels",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "--frozen", "--python", "3.12", "--extra", "test",
        "python", "generate_apriltags.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "CI: Verify Labels",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "--frozen", "--python", "3.12", "--extra", "test",
        "python", "verify_apriltags.py", "--write-reports"
      ],
      "dependsOn": "CI: Generate Labels",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "CI: Console Build",
      "type": "process",
      "command": "npm",
      "args": ["run", "build"],
      "options": {"cwd": "${workspaceFolder}/robot_server/frontend"},
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "CI: Firmware Builds (4 Cars)",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "--no-project", "--python", "3.12",
        "--with", "platformio==6.1.18",
        "python", "-m", "platformio", "run",
        "-d", "esp32_software/firmware",
        "-e", "general-driver", "-e", "car-02", "-e", "car-03", "-e", "car-04"
      ],
      "group": "test",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CI: Documentation Examples",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "--frozen", "--python", "3.12", "--extra", "test",
        "python", "-m", "pytest", "-q", "tests/test_documentation.py"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "CI: Docs Build",
      "type": "process",
      "command": "npm",
      "args": ["run", "docs:build"],
      "problemMatcher": []
    },
    {
      "label": "CI: Docs Tests",
      "type": "process",
      "command": "npm",
      "args": ["run", "docs:test"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "CI: All Checks",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CI: SDK Tests",
        "CI: SDK Types",
        "CI: Control and Firmware Contract",
        "CI: Vision Tests",
        "CI: Verify Labels",
        "CI: Console Build",
        "ACField: Console Browser Tests",
        "ACField: Vision Browser Tests",
        "CI: Firmware Builds (4 Cars)",
        "CI: Documentation Examples",
        "CI: Docs Tests"
      ],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "ACField: All Python Tests",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "--frozen", "--python", "3.12", "--extra", "test",
        "python", "-m", "pytest", "-q", "tests", "robot_server/tests", "sdk/python/tests"
      ],
      "options": {"env": {"ACFIELD_REQUIRE_FIRMWARE_CONTRACT": "1"}},
      "dependsOn": "ACField: Setup Firmware Dependencies",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ACField: All Python Tests (4 Workers)",
      "type": "process",
      "command": "uv",
      "args": [
        "run", "--frozen", "--python", "3.12", "--extra", "test",
        "python", "-m", "pytest", "-q", "-n", "4", "tests", "robot_server/tests", "sdk/python/tests"
      ],
      "options": {"env": {"ACFIELD_REQUIRE_FIRMWARE_CONTRACT": "1"}},
      "dependsOn": "ACField: Setup Firmware Dependencies",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ACField: Console Browser Tests",
      "type": "process",
      "command": "npm",
      "args": ["run", "console:test"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ACField: Vision Browser Tests",
      "type": "process",
      "command": "npm",
      "args": ["run", "vision:test"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
